// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  password      String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  reports       MaintenanceReport[]
}

model MaintenanceReport {
  id          String   @id @default(cuid())
  date        DateTime
  equipment   String
  location    String?
  problem     String
  solution    String
  status      String   @default("Concluído")
  priority    String   @default("Normal")
  notes       String?

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id            Int               @id @default(autoincrement())
  name          String
  sku           String            @unique
  price         Float
  discountPrice Float?            // optional discounted price
  description   String?           // rich text for technical info
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String   // could be a relative path or external URL
  order     Int      @default(0) // ordering of images (0..4)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  color     String   // e.g., "Red", "Black"
  size      String   // e.g., "S", "M", "L"
  stock     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}
